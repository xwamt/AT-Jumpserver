{
  "name": "at-jumpserver-terminal",
  "displayName": "%atJumpServer.displayName%",
  "description": "%atJumpServer.description%",
  "version": "0.1.8",
  "publisher": "local",
  "icon": "media/at-terminal-icon.png",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:jumpserverManager.assets",
    "onView:jumpserverManager.sftpFiles"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jumpserverManager",
          "title": "%atJumpServer.viewsContainer.title%",
          "icon": "media/at-terminal-activity.svg"
        }
      ]
    },
    "views": {
      "jumpserverManager": [
        {
          "id": "jumpserverManager.assets",
          "name": "%atJumpServer.view.assets.name%"
        },
        {
          "id": "jumpserverManager.sftpFiles",
          "name": "%atJumpServer.view.sftpFiles.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "jumpserverManager.configure",
        "title": "%atJumpServer.command.configure.title%",
        "icon": "$(gear)"
      },
      {
        "command": "jumpserverManager.validate",
        "title": "%atJumpServer.command.validate.title%"
      },
      {
        "command": "jumpserverManager.refresh",
        "title": "%atJumpServer.command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "jumpserverManager.connect",
        "title": "%atJumpServer.command.connect.title%"
      },
      {
        "command": "jumpserverManager.copyHostIp",
        "title": "%atJumpServer.command.copyHostIp.title%",
        "icon": "$(copy)"
      },
      {
        "command": "jumpserverManager.sftp.refresh",
        "title": "%atJumpServer.command.sftp.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "jumpserverManager.sftp.goUp",
        "title": "%atJumpServer.command.sftp.goUp.title%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "jumpserverManager.sftp.upload",
        "title": "%atJumpServer.command.sftp.upload.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "jumpserverManager.sftp.download",
        "title": "%atJumpServer.command.sftp.download.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jumpserverManager.sftp.preview",
        "title": "%atJumpServer.command.sftp.preview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "jumpserverManager.sftp.edit",
        "title": "%atJumpServer.command.sftp.edit.title%",
        "icon": "$(edit)"
      },
      {
        "command": "jumpserverManager.sftp.delete",
        "title": "%atJumpServer.command.sftp.delete.title%",
        "icon": "$(trash)"
      },
      {
        "command": "jumpserverManager.sftp.rename",
        "title": "%atJumpServer.command.sftp.rename.title%",
        "icon": "$(edit)"
      },
      {
        "command": "jumpserverManager.sftp.newFolder",
        "title": "%atJumpServer.command.sftp.newFolder.title%",
        "icon": "$(new-folder)"
      },
      {
        "command": "jumpserverManager.sftp.copyPath",
        "title": "%atJumpServer.command.sftp.copyPath.title%",
        "icon": "$(copy)"
      },
      {
        "command": "jumpserverManager.installMcpConfig",
        "title": "%atJumpServer.command.installMcpConfig.title%"
      },
      {
        "command": "jumpserverManager.uninstallAtSeriesMcpConfig",
        "title": "%atJumpServer.command.uninstallAtSeriesMcpConfig.title%"
      },
      {
        "command": "jumpserverManager.disconnect",
        "title": "%atJumpServer.command.disconnect.title%"
      },
      {
        "command": "jumpserverManager.reconnect",
        "title": "%atJumpServer.command.reconnect.title%"
      }
    ],

    "menus": {
      "view/title": [
        {
          "command": "jumpserverManager.configure",
          "when": "view == jumpserverManager.assets",
          "group": "navigation@1"
        },
        {
          "command": "jumpserverManager.refresh",
          "when": "view == jumpserverManager.assets",
          "group": "navigation@2"
        },
        {
          "command": "jumpserverManager.sftp.refresh",
          "when": "view == jumpserverManager.sftpFiles",
          "group": "navigation@1"
        },
        {
          "command": "jumpserverManager.sftp.upload",
          "when": "view == jumpserverManager.sftpFiles",
          "group": "navigation@2"
        },
        {
          "command": "jumpserverManager.sftp.goUp",
          "when": "view == jumpserverManager.sftpFiles",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "jumpserverManager.connect",
          "when": "view == jumpserverManager.assets && (viewItem == jumpserverAsset || viewItem == jumpserverMysqlAsset || viewItem == jumpserverRedisAsset || viewItem == jumpserverUnsupportedAsset)",
          "group": "inline@1"
        },
        {
          "command": "jumpserverManager.copyHostIp",
          "when": "view == jumpserverManager.assets && (viewItem == jumpserverAsset || viewItem == jumpserverMysqlAsset || viewItem == jumpserverRedisAsset || viewItem == jumpserverUnsupportedAsset)",
          "group": "3_copy@1"
        },
        {
          "command": "jumpserverManager.sftp.download",
          "when": "view == jumpserverManager.sftpFiles && viewItem == jumpserverSftpFile",
          "group": "transfer@2"
        },
        {
          "command": "jumpserverManager.sftp.preview",
          "when": "view == jumpserverManager.sftpFiles && viewItem == jumpserverSftpFile",
          "group": "open@2"
        },
        {
          "command": "jumpserverManager.sftp.edit",
          "when": "view == jumpserverManager.sftpFiles && viewItem == jumpserverSftpFile",
          "group": "open@1"
        },
        {
          "command": "jumpserverManager.sftp.upload",
          "when": "view == jumpserverManager.sftpFiles && viewItem == jumpserverSftpDirectory",
          "group": "inline@1"
        },
        {
          "command": "jumpserverManager.sftp.newFolder",
          "when": "view == jumpserverManager.sftpFiles && viewItem == jumpserverSftpDirectory",
          "group": "inline@2"
        },
        {
          "command": "jumpserverManager.sftp.rename",
          "when": "view == jumpserverManager.sftpFiles && (viewItem == jumpserverSftpFile || viewItem == jumpserverSftpDirectory)",
          "group": "2_manage@1"
        },
        {
          "command": "jumpserverManager.sftp.delete",
          "when": "view == jumpserverManager.sftpFiles && (viewItem == jumpserverSftpFile || viewItem == jumpserverSftpDirectory)",
          "group": "2_manage@2"
        },
        {
          "command": "jumpserverManager.sftp.copyPath",
          "when": "view == jumpserverManager.sftpFiles && (viewItem == jumpserverSftpFile || viewItem == jumpserverSftpDirectory)",
          "group": "3_copy@1"
        }
      ]
    },
    "configuration": {
      "title": "%atJumpServer.configuration.title%",
      "properties": {

        "jumpserverManager.terminalFontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8
        },
        "jumpserverManager.terminalFontFamily": {
          "type": "string",
          "default": "Cascadia Code, Menlo, monospace"
        },
        "jumpserverManager.scrollback": {
          "type": "number",
          "default": 5000,
          "minimum": 100
        },
        "jumpserverManager.semanticHighlight": {
          "type": "boolean",
          "default": true
        },
        "jumpserverManager.idleDisconnectMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0
        }
      }
    }
  },
  "scripts": {
    "copy:hub": "node scripts/copy-hub.mjs",
    "build": "node esbuild.config.mjs && npm run copy:hub",
    "probe:sftp": "node tools/probe-jumpserver-sftp.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "@at-series/mcp-hub": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
